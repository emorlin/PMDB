# Klient (Vite) - VITE_-prefixade variabler hamnar i den publika JS-bundeln.
# Supabase anon-nyckel är avsedd att vara publik (skyddet sker via RLS-policyer).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Delad hemlighet som skickas med proxy-anropen mot TMDB/OMDb. Låg känslighet
# (se src/lib/proxy.ts) – skyddar bara mot att kvoten förbrukas av bottar,
# ersätter inte inloggning.
VITE_PROXY_SECRET=

# Clerk – inloggning (Google) som krävs för att lägga till/redigera/ta bort
# filmer och platser. Samma Clerk-app som används i bokklubben-projektet.
VITE_CLERK_PUBLISHABLE_KEY=

# Server-only (används bara i /api/*.ts, aldrig VITE_-prefixade,
# hamnar därför aldrig i webbläsarens JS-bundel).
TMDB_API_KEY=
OMDB_API_KEY=
PROXY_SECRET=
CLERK_SECRET_KEY=
